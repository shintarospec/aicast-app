{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "🚀 AIcast Room 起動",
            "type": "shell",
            "command": "python3 run.py",
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "new",
                "showReuseMessage": true,
                "clear": false
            },
            "isBackground": true,
            "problemMatcher": [],
            "runOptions": {
                "runOn": "default"
            }
        },
        {
            "label": "🔍 Vertex AI 認証テスト",
            "type": "shell",
            "command": "python3 test_vertex_vps.py",
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "new"
            }
        },
        {
            "label": "🛠️ 依存関係インストール",
            "type": "shell",
            "command": "pip3 install -r requirements.txt",
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true
            }
        },
        {
            "label": "🔐 Google Cloud認証",
            "type": "shell",
            "command": "gcloud auth application-default login --no-launch-browser",
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true
            }
        }
    ]
}